{
  "name": "viewer",
  "private": true,
  "type": "module",
  "engines": { "node": "26.x", "pnpm": "11.x" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts --dev",
    "build": "vite build",
    "demo": "pnpm build && node src/server.ts --demo",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
    "test": "pnpm build && pnpm test:unit && pnpm test:browser",
    "test:unit": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  }
}
