{
  "name": "local-codex-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "check": "node scripts/workspace.ts check && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit && pnpm --filter viewer typecheck",
    "test": "node --test tests/*.test.ts && pnpm --filter viewer test",
    "viewer:docker:build": "docker compose build viewer",
    "viewer:docker": "docker compose up --build -d --wait viewer",
    "viewer:docker:stop": "docker compose down",
    "viewer:docker:logs": "docker compose logs -f viewer",
    "new": "node scripts/workspace.ts new",
    "link": "node scripts/workspace.ts link"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "5.9.3"
  }
}
